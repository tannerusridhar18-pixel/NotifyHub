# Copy this file to application-local.yml for local development.
# application-local.yml is ignored by Git and must never be committed.

spring:
  datasource:
    username: root
    password: REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD

notifyhub:
  jwt-secret: REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
  auth:
    cookie-secure: false
    cookie-same-site: Lax
  frontend-origin: http://localhost:3000
  admin-username: admin
  admin-email: admin@notifyhub.com
  admin-password: REPLACE_WITH_A_STRONG_LOCAL_ADMIN_PASSWORD
  admin-sync-password: true

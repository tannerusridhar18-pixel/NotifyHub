# Copy these values into your deployment/IDE environment.
# Never commit a real .env file.
DB_URL=jdbc:mysql://localhost:3306/notifyhub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@notifyhub.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_QUERY_PER_MINUTE=10

# Outbound Email Delivery Configuration
# Set MAIL_ENABLED=true in production to enable email dispatch
MAIL_ENABLED=false
# Email provider: 'resend' (recommended for production/Railway HTTPS port 443), 'smtp', or 'auto'
MAIL_PROVIDER=resend
# Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here
# Sender email: Must use a verified domain in Resend or onboarding@resend.dev for testing
MAIL_FROM=onboarding@resend.dev
INVITATION_PATH=/auth/register
ANNOUNCEMENT_PATH=/announcements
ADMIN_SYNC_PASSWORD=true

# Alternative Legacy SMTP Configuration (Only used when MAIL_PROVIDER=smtp)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_smtp_username
# MAIL_PASSWORD=your_smtp_password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
